# Root `.env` for Docker Compose variable substitution.
# Copy to `.env` in this directory, or set these in Dokploy's Environment UI.
#
#   cp .env.docker.example .env
#
# Compose reads this file automatically; values are passed into the backend container
# via `environment:` entries in docker-compose.yml.

# --- Required ---
ACCESS_SECRET=change_me_min_32_chars
REFRESH_SECRET=change_me_min_32_chars

# --- Infra (defaults work with compose mongodb + valkey services) ---
MONGODB_URI=mongodb://mongodb:27017/blogforall
REDIS_URL=redis://valkey:6379
NODE_ENV=development
PORT=5005

# --- URLs ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5005

# --- Notifications (Brevo) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@bloggr.com
BREVO_SENDER_NAME=Bloggr
BREVO_WAITLIST_LIST_ID=

# --- Billing ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI ---
OPENAI_API_KEY=
TAVILY_API_KEY=

# --- Observability (optional) ---
SENTRY_DSN=
POSTHOG_API_KEY=

# --- Admin seed (optional) ---
ADMIN_SEED_ON_START=false
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FIRST_NAME=
ADMIN_SEED_LAST_NAME=
ADMIN_SEED_ROLE=
