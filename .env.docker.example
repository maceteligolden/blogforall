# Copy to .env in the repo root (optional) before `docker compose up`.
# Compose also loads backend/.env for app secrets (JWT, Brevo, Stripe, etc.).

# MongoDB in the compose stack (override to use Atlas or host MongoDB instead)
MONGODB_URI=mongodb://mongodb:27017/blogforall

# REDIS_URL is set automatically to redis://valkey:6379 in docker-compose.yml
