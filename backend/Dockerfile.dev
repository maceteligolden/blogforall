# Development Dockerfile — hot reload via ts-node (local Docker only)
FROM node:22-alpine

WORKDIR /app

RUN corepack enable && npm install -g nodemon ts-node

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

COPY . .

RUN mkdir -p uploads

EXPOSE 5005

# Anonymous /app/node_modules volume can go stale when package.json gains deps.
# Reconcile on start so host lockfile changes are installed into the volume.
CMD ["sh", "-c", "yarn install --frozen-lockfile && exec nodemon src/index.ts"]
